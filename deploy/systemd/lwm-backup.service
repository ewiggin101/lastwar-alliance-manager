[Unit]
Description=LastWar Alliance Manager SQLite backup

[Service]
Type=oneshot
# deploy/lwm-backup.sh: sqlite3 snapshot, config bundle, SQL dump to GitHub.
# It needs sqlite3 on the host -- the DB is not in WAL mode, so backup.sh's
# cp fallback could take a torn copy mid-write.
ExecStart=/bin/bash /home/ubuntu/lastwar-alliance-manager/deploy/lwm-backup.sh
