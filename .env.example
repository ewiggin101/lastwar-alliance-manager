# Database location (persistent storage)
DATABASE_PATH=/var/lib/lastwar/alliance.db

# Session secret key (generate with: openssl rand -hex 32)
# IMPORTANT: Change this in production!
SESSION_KEY=your-random-64-character-hex-string-here-change-this-in-production

# Optional FarmOps API key for authenticated THP refreshes and the
# alliance-export sync (roster, power/kill/THP history, weekly donations).
# LASTWAR_FARM_API_KEY=fops_live_your-key

# How often the background FarmOps export sync runs (Go duration). Default 6h.
# The sync only runs when LASTWAR_FARM_API_KEY is set.
# LASTWAR_FARM_SYNC_INTERVAL=6h

# Production mode - enables secure cookies (HTTPS only)
PRODUCTION=true
HTTPS=true

# Server port (8080 for reverse proxy behind Caddy/Nginx)
PORT=8080
